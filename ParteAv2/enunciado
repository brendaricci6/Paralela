/*
 * gen_test_data_balanced2: random input with maximum imbalance of 1.
 *
 * Each bin receives either floor(nelements/nbins) or
 * floor(nelements/nbins)+1 elements — the most balanced histogram
 * achievable with uniform-in-[0,nbins) values.
 *
 * Algorithm:
 *   1. Fill data[i] = i, so values 0..nelements-1 are each present once.
 *   2. Fisher-Yates shuffle to randomise the order.
 *   3. Change each value modulo nbins.
 *
 * After step 3, value b appears in data[] exactly:
 *   - floor(nelements/nbins) + 1  times,  for b < nelements % nbins
 *   - floor(nelements/nbins)      times,  for b >= nelements % nbins
 * Maximum bin imbalance is therefore exactly 1.
 */
static void gen_test_data_balanced2(long long *data,
                                     long long nelements,
                                     int nbins)
{
    if (nelements <= 0 || nbins <= 0) return;

    /* 1. Fill with 0, 1, 2, ..., nelements-1 */
    for (long long i = 0; i < nelements; i++)
        data[i] = i;

    /* 2. Fisher-Yates shuffle */
    for (long long i = nelements - 1; i > 0; i--) {
        long long j = (long long)(rand63() % (unsigned long long)(i + 1));
        ll_swap(&data[i], &data[j]);
    }

    /* 3. Change each value of the input to be in [0, nbins) */
    for (long long i = 0; i < nelements; i++)
        data[i] %= nbins;
}
